# onTrack backend environment contract.
#
# Copy to .env and fill in real values for local dev:
#     cp .env.example .env
#
# .env is gitignored. This file is committed and holds no secrets.
#
# Loading and precedence. spring-dotenv inserts .env directly after
# systemEnvironment in the property sources, so the order is:
#
#     system properties  >  OS env vars  >  .env  >  application-dev.properties
#
# An exported shell variable therefore beats .env silently. If a value here
# looks like it is being ignored, check your shell environment first.
#
# In prod there is no .env. These same names are set as env vars on the host,
# with SPRING_PROFILES_ACTIVE=prod.

# ----- Postgres -----
# WSL note: if Postgres runs on Windows rather than inside WSL, localhost will not reach it.
# Use the Windows host adapter address instead (it is in the 172.16.0.0/12 private range and
# CHANGES ON EVERY WINDOWS REBOOT). Find it with:  ip route show | awk '/default/ {print $3}'
# Better: set networkingMode=mirrored in .wslconfig, after which localhost just works.
DB_URL=jdbc:postgresql://localhost:5432/tracker_db
DB_USERNAME=
DB_PASSWORD=


# ----- App / web -----
SITE_BASE_URL=http://localhost:8080
# Expo web serves on 8081. Add 3000 for a separate React dev server.
CORS_ALLOWED_ORIGIN=http://localhost:8081,http://localhost:3000
APP_CURRENT_TERM_SEASON=Winter
APP_CURRENT_TERM_YEAR=2026

# ----- Secrets -----
# Base64, 32 bytes each. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=
# Changing this makes every grade already in the database undecryptable.
GRADE_ENCRYPTION_KEY=
CALENDAR_LINK_TOKEN_SECRET=

# ----- Third party -----
RESEND_API_KEY=
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback

# ----- Jobs -----
# Sent as the X-Jobs-Token header to POST /internal/jobs/*.
JOBS_TRIGGER_TOKEN=dev-jobs-token

# ----- Optional. Both have defaults in application.yml. -----
# LEADERBOARD_RECOMPUTE_CRON=0 0 6,14,22 * * *
# CALENDAR_OAUTH_SUCCESS_REDIRECT=/api/calendar/google/success
